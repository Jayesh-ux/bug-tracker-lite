# Base URL for the backend API. Leave empty in development: Vite proxies /api -> :4000.
# In production this must be the full HTTPS URL of the deployed API.
VITE_API_URL=/api

# Set to 1 only for the GitHub Pages release build (hosted at /bug-tracker-lite/).
# Leave unset for `vite dev` and plain `vite build`.
VITE_GHPAGES=