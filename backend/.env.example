# Copy to backend/.env and fill in real values. Never commit .env.
# AWS credentials are NOT read from here: the SDK default provider chain is used
# (~/.aws/credentials locally, IAM role on EC2).

# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgres://bugtracker:bugtracker@localhost:5432/bugtracker
# Optional: enable TLS to managed Postgres (RDS). Path to a CA bundle on disk.
# The pg driver ignores sslmode= in the URL, so set this when using RDS:
#   # with the bundle on the server:
#   #   curl -o /home/ec2-user/global-bundle.pem \
#   #     https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# PG_SSL_CA=/home/ec2-user/global-bundle.pem

# Auth - required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# S3
AWS_REGION=us-east-1
S3_BUCKET=bug-tracker-lite-images