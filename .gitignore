# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
frontend/dist/
backend/coverage/

# Environment files - only .env.example is ever committed
.env
.env.*
!.env.example

# Secrets / keys - never commit
*.pem
*.key
credentials
.aws/
aws-credentials

# Logs
logs/
*.log
*.vite.log
*.vite.err.log
npm-debug.log*
!docs/phase4-verification.log

# Test / tooling artifacts
coverage/
.vitest/
playwright-report/
test-results/
*.tgz
*.tmp.mjs
*.tmp.js

# Local runtime (never committed)
backend/server.pid
backend/server.log
backend/server.log.err
backend/server.log.*

# e2e scratch (upload fixtures used by the smoke test)
docs/screenshots/.tmp/

# e2e scratch output (Playwright run logs)
frontend/e2e/responsive.out.txt

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker volumes
pgdata/

# Local server env (never committed)
deploy/.env
server/.env
